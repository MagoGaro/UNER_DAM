# Dirección de la API de Mi Ciudad.
# Copiá este archivo a `.env.local`. Sin EXPO_PUBLIC_API_URL la app no inventa datos:
# muestra «Hay un problema con el servidor».
#
# Desde el celular no sirve localhost: usá la IP que imprime la API al arrancar.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#
# Con la API publicada en la nube: EXPO_PUBLIC_API_URL=https://su-api.onrender.com
